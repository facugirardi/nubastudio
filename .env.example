# Google Gemini API key for the "Polish with AI" composer in /contact.
# Free tier: https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key. Never commit .env.local.
GEMINI_API_KEY=

# Canonical site URL used for metadata, canonicals, sitemap.xml and robots.txt.
# Defaults to https://nuba.studio if unset.
NEXT_PUBLIC_SITE_URL=https://nuba.studio
